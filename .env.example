# Copy to .env for local use (".env" is git-ignored). Never commit real secrets.
PORT=4000
# Listens on loopback only by default. Use 0.0.0.0 only if you want LAN access.
HOST=127.0.0.1
# SQLite file path, or :memory: for a throw-away database
DB_FILE=data/taxi.db
# Set to true when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false
# Seed demo users + sample data on an EMPTY database. Passwords are mandatory when true.
SEED_DEMO=true
ADMIN_PASSWORD=
DISPATCHER_PASSWORD=
